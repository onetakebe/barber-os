# Supabase (projeto "AS barber shop"): use o Session pooler (porta 5432, IPv4) no runtime
# e nas migrações. Transaction pooler (6543) só se rodar em serverless — e aí com DIRECT_URL
# apontando para o session pooler para o `prisma migrate`.
DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"
# DIRECT_URL="" (opcional; a CLI do Prisma usa esta se existir)
# Assina cookies temporários do login social (qualquer string longa e aleatória).
AUTH_SECRET=""
# Login social — cada provedor só aparece funcional quando as suas variáveis existem.
# Redirect URI a cadastrar em cada console: <NEXT_PUBLIC_APP_URL>/api/auth/<google|facebook|apple>/callback
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""
# Apple: Services ID como client id, Team ID, Key ID e a chave .p8 (PEM, com \n nas quebras).
AUTH_APPLE_ID=""
AUTH_APPLE_TEAM_ID=""
AUTH_APPLE_KEY_ID=""
AUTH_APPLE_PRIVATE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
