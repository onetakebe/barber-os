# Supabase (projeto "AS barber shop"): use o Session pooler (porta 5432, IPv4) no runtime
# e nas migrações. Transaction pooler (6543) só se rodar em serverless — e aí com DIRECT_URL
# apontando para o session pooler para o `prisma migrate`.
DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"
# DIRECT_URL="" (opcional; a CLI do Prisma usa esta se existir)
# Supabase Auth (etapa 2). Google/Apple/Facebook são configurados no painel do Supabase
# (Authentication > Providers), com redirect https://<ref>.supabase.co/auth/v1/callback.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Chave secreta (Project Settings > API keys > secret): criar/convidar/apagar usuários. Só no servidor.
SUPABASE_SECRET_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
